{
  "mcpServers": {
    "subetha": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://subetha.us/mcp",
        "--header",
        "Authorization: Bearer ${SUBETHA_TOKEN}"
      ],
      "env": {
        "SUBETHA_TOKEN": "se_replace_me"
      }
    }
  }
}
