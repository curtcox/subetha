{
  "name": "@subetha/sdk",
  "version": "0.0.1",
  "description": "SubEtha TypeScript SDK: publish and subscribe over any transport.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./protocol": "./src/protocol/index.ts",
    "./edge": "./src/edge/index.ts",
    "./edge/lan-node": "./src/edge/lan-node.ts"
  },
  "bin": {
    "subetha": "./bin/subetha.js"
  },
  "files": [
    "src",
    "bin",
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "jsqr": "1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./protocol": {
        "types": "./dist/types/protocol/index.d.ts",
        "import": "./dist/protocol.js"
      },
      "./edge": {
        "types": "./dist/types/edge/index.d.ts",
        "import": "./dist/edge-lib.js"
      },
      "./edge/lan-node": {
        "types": "./dist/types/edge/lan-node.d.ts",
        "import": "./dist/edge-lan-node.js"
      }
    }
  }
}
