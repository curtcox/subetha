    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@subetha/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsqr": "1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
