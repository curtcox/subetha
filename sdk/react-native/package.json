{
  "name": "@subetha/react-native",
  "version": "0.0.1",
  "description": "SubEtha for React Native: the TypeScript SDK plus RN transport defaults and edge glue; loads the Rust core from @subetha/react-native-core when installed.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
