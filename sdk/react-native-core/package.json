{
  "name": "@subetha/react-native-core",
  "version": "0.0.1",
  "description": "The SubEtha Rust core (sdk/core) for React Native: a JSI Turbo Module generated by uniffi-bindgen-react-native.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtcox/subetha.git",
    "directory": "sdk/react-native-core"
  },
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "react-native": "./src/index.tsx",
  "source": "./src/index.tsx",
  "files": [
    "src",
    "cpp",
    "android",
    "ios",
    "*.podspec",
    "build/SubEthaCoreFramework.xcframework",
    "ubrn.config.yaml",
    "!android/build",
    "!android/.cxx",
    "!android/generated",
    "!ios/generated"
  ],
  "scripts": {
    "generate": "../core/scripts/gen-rn-bindings.sh",
    "check": "../core/scripts/gen-rn-bindings.sh --check",
    "typecheck": "tsc -p .",
    "ubrn:android": "ubrn build android --config ubrn.config.yaml --release",
    "ubrn:ios": "ubrn build ios --config ubrn.config.yaml --release"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "codegenConfig": {
    "name": "RNSubEthaCoreSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "outputDir": {
      "ios": "ios/generated",
      "android": "android/generated"
    },
    "android": {
      "javaPackageName": "org.subetha.reactnativecore"
    }
  },
  "dependencies": {
    "uniffi-bindgen-react-native": "0.28.3-5"
  }
}
