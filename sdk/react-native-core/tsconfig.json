{
  // Typechecks the generated bindings and test/compat.ts. Standalone (not tsconfig.base.json):
  // the generated code and ubrn's runtime use TypeScript features the repo's base config bans,
  // and TypeScript ≥ 5.7's typed-array generics reject ubrn 0.28's runtime, so this package pins
  // TypeScript 5.6 (React Native apps type-check it with their own compiler).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/generated", "test"]
}
